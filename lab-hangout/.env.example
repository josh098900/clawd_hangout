# Copy this file to .env.local and fill in your Supabase project values
# (Supabase dashboard -> Project Settings -> API).
# Leave them blank to run in LOCAL mode: tabs on the same browser see each other,
# no server needed.
VITE_SUPABASE_URL=
# The "anon" public key (newer projects call it the "publishable" key). Never put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=
# Optional: Cloudflare Turnstile site key (the public one). When set, a first visit does a quick
# human check before signing in. Put the matching SECRET key in Supabase:
# Auth -> Attack Protection -> CAPTCHA protection -> Turnstile.
VITE_TURNSTILE_SITE_KEY=
# Optional: which login buttons to show next to "Play as guest" (set them up first: README ->
# "Logging in with Discord and Google"). Comma-separated: discord,google. Empty = guests only.
VITE_AUTH_PROVIDERS=
